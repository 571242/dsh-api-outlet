{
  "name": "@oracle-ai/dsh-api-outlet",
  "version": "1.1.3-local",
  "description": "DSH subscription API outlet with official plugin settings, provider/model access control, per-client token usage and reasoning effort selection.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test tests/*.test.js"
  },
  "main": "./lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": {
      "types": "./client/index.d.ts",
      "default": "./client/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "client/",
    "scripts/",
    "tests/",
    "cordis.patch.yml",
    "README.md",
    "PROTOCOL.md",
    "PROVIDERS.md",
    "ADMIN.md",
    "SHA256SUMS"
  ],
  "engines": {
    "node": ">=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/cordis": "4.0.4"
  }
}
